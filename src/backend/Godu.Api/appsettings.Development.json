{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KeyVault": {
    "VaultUri": "https://gd-keyvault-local.vault.azure.net/"
  },
  "Auth0": {
    "Domain": "godu.uk.auth0.com",
    "Audience": "https://api.godu.it"
  },
  "Cosmos": {
    "UseInMemory": false,
    "DatabaseName": "godu",
    "AccountEndpoint": "https://localhost:8081/"
  },
  "TikTok": {
    "RedirectUri": "https://localhost:7166/api/me/platform-accounts/tiktok/callback",
    "FrontendReturnUrl": "http://localhost:4200/settings",
    "Scopes": "user.info.basic,user.info.profile,video.list"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  }
}
