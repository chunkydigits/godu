{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KeyVault": {
    "VaultUri": "https://gd-keyvault-local.vault.azure.net/"
  },
  "Auth0": {
    "Domain": "godu.uk.auth0.com",
    "Audience": "https://api.godu.uk"
  },
  "Cosmos": {
    "UseInMemory": false,
    "DatabaseName": "godu",
    "AccountEndpoint": "https://localhost:8081/"
  },
  "TikTok": {
    "RedirectUri": "https://dev.godu.it/tiktok/callback",
    "FrontendReturnUrl": "https://dev.godu.it/settings",
    "Scopes": "user.info.basic,user.info.profile,video.list"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4300",
      "https://dev.godu.it"
    ]
  },
  "Analytics": {
    "Environment": "Development",
    "InternalUserIds": [],
    "AdminUserIds": [],
    "AllowAnyAuthenticatedAdmin": false
  }
}
