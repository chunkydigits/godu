{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "VaultUri": "https://gd-keyvault-prod.vault.azure.net/"
  },
  "Auth0": {
    "Domain": "godu.uk.auth0.com",
    "Audience": "https://api.godu.uk"
  },
  "Cosmos": {
    "UseInMemory": false,
    "DatabaseName": "godu",
    "AccountEndpoint": "https://gd-cosmos-prod.documents.azure.com:443/"
  },
  "TikTok": {
    "RedirectUri": "https://godu.it/tiktok/callback",
    "FrontendReturnUrl": "https://godu.it/settings",
    "Scopes": "user.info.basic,user.info.profile,video.list"
  },
  "Cors": {
    "AllowedOrigins": ["https://www.godu.it", "https://godu.it"]
  },
  "CreatorMonetisation": {
    "MonthlyPriceGbp": 9.99
  },
  "Email": {
    "From": "noreply@godu.it",
    "FromName": "Godu",
    "Region": "eu-north-1",
    "PollIntervalHours": 1
  },
  "Analytics": {
    "Environment": "Production",
    "InternalUserIds": [],
    "AdminUserIds": [],
    "AllowAnyAuthenticatedAdmin": false
  }
}
