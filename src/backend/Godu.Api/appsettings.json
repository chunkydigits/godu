{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "VaultUri": "https://gd-keyvault-prod.vault.azure.net/"
  },
  "Auth0": {
    "Domain": "godu.uk.auth0.com",
    "Audience": "https://api.godu.uk"
  },
  "Cosmos": {
    "UseInMemory": false,
    "DatabaseName": "godu",
    "AccountEndpoint": "https://gd-cosmos-prod.documents.azure.com:443/"
  },
  "TikTok": {
    "RedirectUri": "https://api.godu.uk/api/me/platform-accounts/tiktok/callback",
    "FrontendReturnUrl": "https://www.godu.it/settings",
    "Scopes": "user.info.basic,user.info.profile,video.list"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.godu.it",
      "https://godu.it"
    ]
  }
}
